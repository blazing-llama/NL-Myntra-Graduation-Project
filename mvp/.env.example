# Vite only exposes client-side vars prefixed VITE_ — these are separate
# from the root .env's SUPABASE_URL/SUPABASE_ANON_KEY (which pipeline/
# scripts use). The anon key is safe to expose client-side by Supabase's
# own design (Row Level Security enforces access — see mvp/supabase/schema.sql);
# this is NOT the same trust model as GROQ_API_KEY, which must never be
# prefixed VITE_ or referenced from mvp/src — it stays server-side only,
# in mvp/api/narrate.ts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
